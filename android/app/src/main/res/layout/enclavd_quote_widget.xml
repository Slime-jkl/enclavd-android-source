<?xml version="1.0" encoding="utf-8"?>
<!-- Daily-quote widget card: dark gray-900 surface, same look as the web
     toast. Rendered by QuoteWidgetProvider via RemoteViews — only views in
     the RemoteViews whitelist are allowed here (LinearLayout/TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quote_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/quote_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/quote_widget_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/quote_widget_logo"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/quote_widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="QUOTE OF THE DAY"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <TextView
        android:id="@+id/quote_widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="—"
        android:textColor="#E5E7EB"
        android:textSize="16sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/quote_widget_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/quote_widget_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />

    <!-- Like/dislike row: taps wake a headless Dart callback (the rating is
         recorded in the API, then this widget re-renders tinted). -->
    <LinearLayout
        android:id="@+id/quote_widget_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quote_widget_like"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/quote_widget_action_bg"
            android:gravity="center"
            android:text="👍"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/quote_widget_dislike"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/quote_widget_action_bg"
            android:gravity="center"
            android:text="👎"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
