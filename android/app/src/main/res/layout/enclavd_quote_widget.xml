<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews whitelist only: FrameLayout/LinearLayout/TextView/ImageView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quote_widget_bg"
    android:padding="14dp">

    <ImageView
        android:id="@+id/quote_widget_watermark"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:src="@drawable/quote_widget_logo"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/quote_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quote_widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="QUOTE OF THE DAY"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- App wordmark; sized by the provider from the widget width. -->
            <ImageView
                android:id="@+id/quote_widget_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/quote_widget_logo"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/quote_widget_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="&#8220;"
            android:textColor="#3B82F6"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quote_widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:text="-"
            android:textColor="#E5E7EB"
            android:textSize="20sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/quote_widget_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quote_widget_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/quote_widget_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quote_widget_like"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/quote_widget_action_bg"
                android:gravity="center"
                android:text="&#x1F44D;"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/quote_widget_dislike"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/quote_widget_action_bg"
                android:gravity="center"
                android:text="&#x1F44E;"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quote_widget_rated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/quote_widget_close_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:text="&#8221;"
        android:textColor="#3B82F6"
        android:textSize="28sp"
        android:textStyle="bold" />
</FrameLayout>
